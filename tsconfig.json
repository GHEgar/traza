{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "types": [],
        "paths": {
            "@npmegar/traza": [
                "./src/core/index.ts"
            ],
            "@npmegar/traza/osm": [
                "./src/osm/index.ts"
            ],
            "@npmegar/traza/sources": [
                "./src/sources/index.ts"
            ],
            "@npmegar/traza/orientation": [
                "./src/orientation/index.ts"
            ],
            "@npmegar/traza/stats": [
                "./src/stats/index.ts"
            ],
            "@npmegar/traza/names": [
                "./src/names/index.ts"
            ],
            "@npmegar/traza/poster": [
                "./src/poster/index.ts"
            ],
            "@npmegar/traza/svg": [
                "./src/svg/index.ts"
            ],
            "@npmegar/traza/ol": [
                "./src/ol/index.ts"
            ]
        },
        "resolveJsonModule": true
    },
    "include": [
        "src",
        "test",
        "demo"
    ]
}
